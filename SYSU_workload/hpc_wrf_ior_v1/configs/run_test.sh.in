#!/usr/bin/env bash
set -euo pipefail

# SYSU WRF IOR - formal read/write lifecycle test.

ANCHOR="@ANCHOR@"
IOR_BIN="@IOR_BIN@"
MPI_RUN="@MPI_RUN@"
MPI_HOSTFILE="@MPI_HOSTFILE@"
NP="4"
API="POSIX"
BLOCK_SIZE="64000m"
TRANSFER_SIZE="4m"
SEGMENT_COUNT="1"
PHASE_SECONDS="@PHASE_SECONDS@"

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
OUTPUT_DIR=${IOR_OUTPUT_DIR:-$script_dir/../output/run_test}

mpi_args=(-np "$NP")
if [[ -n "$MPI_HOSTFILE" ]]; then
    mpi_args+=(--hostfile "$MPI_HOSTFILE")
fi

for required in startup checkpoint history; do
    if [[ ! -d "$ANCHOR/$required" ]]; then
        echo "Missing prepared data directory: $ANCHOR/$required" >&2
        echo "Run prepare_data.sh before the formal test." >&2
        exit 1
    fi
done
mkdir -p -- "$OUTPUT_DIR"

run_ior_read() {
    local phase=$1
    local target=$2
    local log="$OUTPUT_DIR/${phase}.log"
    echo "== $phase read $target =="
    "$MPI_RUN" "${mpi_args[@]}" "$IOR_BIN" \
        -a "$API" --posix.odirect -F -r -k \
        -o "$target" \
        -b "$BLOCK_SIZE" \
        -t "$TRANSFER_SIZE" \
        -s "$SEGMENT_COUNT" \
        -i 1 \
        -D "$PHASE_SECONDS" \
        -O "minTimeDuration=$PHASE_SECONDS" \
        -O stoneWallingWearOut=0 \
        2>&1 | tee "$log"
}

run_ior_write() {
    local phase=$1
    local target=$2
    local log="$OUTPUT_DIR/${phase}.log"
    echo "== $phase write $target =="
    "$MPI_RUN" "${mpi_args[@]}" "$IOR_BIN" \
        -a "$API" --posix.odirect -F -w -k -e \
        -o "$target" \
        -b "$BLOCK_SIZE" \
        -t "$TRANSFER_SIZE" \
        -s "$SEGMENT_COUNT" \
        -i 1 \
        -D "$PHASE_SECONDS" \
        -O "minTimeDuration=$PHASE_SECONDS" \
        -O stoneWallingWearOut=0 \
        2>&1 | tee "$log"
}

run_ior_read startup_read "$ANCHOR/startup/wrf_state"
run_ior_write checkpoint_write "$ANCHOR/checkpoint/wrfrst_current"
run_ior_write history_write "$ANCHOR/history/wrfout_current"
run_ior_read checkpoint_reheat "$ANCHOR/checkpoint/wrfrst_current"
