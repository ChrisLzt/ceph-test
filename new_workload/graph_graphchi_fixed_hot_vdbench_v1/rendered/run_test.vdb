* GraphChi fixed-hot vdbench v1 - run only
* Reuses graph_graphchi_vdbench_v1 data.
* Purpose: isolate fixed-hot behavior from GraphChi PSW hotspot migration.

data_errors=1
create_anchors=yes
messagescan=no
abort_failed_skew=2

hd=default,vdbench=/home/chris/PDSL/vdbench,user=chris,shell=ssh
hd=hd1,system=s52.servers.hustpdsl.cn

fsd=default,depth=1,width=1,files=1800,size=16m,shared=yes,openflags=o_direct
fsd=fsd_s0,anchor=/mnt/cephfs/graph_graphchi_vdbench_v1/shard_00
fsd=fsd_s1,anchor=/mnt/cephfs/graph_graphchi_vdbench_v1/shard_01
fsd=fsd_s2,anchor=/mnt/cephfs/graph_graphchi_vdbench_v1/shard_02
fsd=fsd_s3,anchor=/mnt/cephfs/graph_graphchi_vdbench_v1/shard_03

fwd=fixed_i0_s0,fsd=fsd_s0,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=16,skew=75
fwd=fixed_i0_s1,fsd=fsd_s1,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=16,skew=13
fwd=fixed_i0_s2,fsd=fsd_s2,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=16,skew=6
fwd=fixed_i0_s3,fsd=fsd_s3,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=16,skew=6

fwd=fixed_i1_s0,fsd=fsd_s0,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=16,skew=75
fwd=fixed_i1_s1,fsd=fsd_s1,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=16,skew=13
fwd=fixed_i1_s2,fsd=fsd_s2,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=16,skew=6
fwd=fixed_i1_s3,fsd=fsd_s3,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=16,skew=6

fwd=fixed_i2_s0,fsd=fsd_s0,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=16,skew=75
fwd=fixed_i2_s1,fsd=fsd_s1,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=16,skew=13
