rd=fixed_i0,fwd=(fixed_i0_s0,fixed_i0_s1,fixed_i0_s2,fixed_i0_s3),fwdrate=1000,elapsed=75,interval=1
rd=fixed_i1,fwd=(fixed_i1_s0,fixed_i1_s1,fixed_i1_s2,fixed_i1_s3),fwdrate=1000,elapsed=75,interval=1
rd=fixed_i2,fwd=(fixed_i2_s0,fixed_i2_s1,fixed_i2_s2,fixed_i2_s3),fwdrate=1000,elapsed=75,interval=1
rd=fixed_i3,fwd=(fixed_i3_s0,fixed_i3_s1,fixed_i3_s2,fixed_i3_s3),fwdrate=1000,elapsed=75,interval=1
rd=fixed_i4,fwd=(fixed_i4_s0,fixed_i4_s1,fixed_i4_s2,fixed_i4_s3),fwdrate=1000,elapsed=75,interval=1
