fwd=fixed_i3_s2,fsd=fsd_s2,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=16,skew=6
fwd=fixed_i3_s3,fsd=fsd_s3,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=16,skew=6

