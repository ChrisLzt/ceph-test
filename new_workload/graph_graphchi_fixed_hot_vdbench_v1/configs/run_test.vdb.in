fwd=fixed_i5_s1,fsd=fsd_s1,operation=read,fileio=sequential,fileselect=random,xfersize=@XFER_SIZE@,threads=@THREADS@,skew=13
fwd=fixed_i5_s2,fsd=fsd_s2,operation=read,fileio=sequential,fileselect=random,xfersize=@XFER_SIZE@,threads=@THREADS@,skew=6
