fwd=fixed_i7_s1,fsd=fsd_s1,operation=read,fileio=sequential,fileselect=random,xfersize=@XFER_SIZE@,threads=@THREADS@,skew=13
fwd=fixed_i7_s2,fsd=fsd_s2,operation=read,fileio=sequential,fileselect=random,xfersize=@XFER_SIZE@,threads=@THREADS@,skew=6
fwd=fixed_i7_s3,fsd=fsd_s3,operation=read,fileio=sequential,fileselect=random,xfersize=@XFER_SIZE@,threads=@THREADS@,skew=6

rd=fixed_i0,fwd=(fixed_i0_s0,fixed_i0_s1,fixed_i0_s2,fixed_i0_s3),fwdrate=@FWD_RATE@,elapsed=@PHASE_SECONDS@,interval=1
rd=fixed_i1,fwd=(fixed_i1_s0,fixed_i1_s1,fixed_i1_s2,fixed_i1_s3),fwdrate=@FWD_RATE@,elapsed=@PHASE_SECONDS@,interval=1
rd=fixed_i2,fwd=(fixed_i2_s0,fixed_i2_s1,fixed_i2_s2,fixed_i2_s3),fwdrate=@FWD_RATE@,elapsed=@PHASE_SECONDS@,interval=1
rd=fixed_i3,fwd=(fixed_i3_s0,fixed_i3_s1,fixed_i3_s2,fixed_i3_s3),fwdrate=@FWD_RATE@,elapsed=@PHASE_SECONDS@,interval=1
