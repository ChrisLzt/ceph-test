* MapReduce fixed-hot vdbench v1 - run only
* Reuses the existing bigdata_mapreduce_vdbench_v1 dataset.
* Purpose: isolate fixed-hot behavior from hotspot migration behavior.

data_errors=1
create_anchors=yes
messagescan=no
abort_failed_skew=2

hd=default,vdbench=/home/chris/PDSL/vdbench,user=chris,shell=ssh
hd=hd1,system=s52.servers.hustpdsl.cn

fsd=default,depth=1,width=1,shared=yes,openflags=o_direct
fsd=fsd_a,anchor=/mnt/cephfs/bigdata_mapreduce_vdbench_v1/pool_01,files=400,size=12m
fsd=fsd_b,anchor=/mnt/cephfs/bigdata_mapreduce_vdbench_v1/pool_02,files=400,size=12m
fsd=fsd_c,anchor=/mnt/cephfs/bigdata_mapreduce_vdbench_v1/pool_03,files=400,size=12m
fsd=fsd_bg,anchor=/mnt/cephfs/bigdata_mapreduce_vdbench_v1/pool_04,files=8800,size=12m

fwd=fixed_a_1_a,fsd=fsd_a,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=16,skew=85
fwd=fixed_a_1_b,fsd=fsd_b,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=16,skew=1
fwd=fixed_a_1_c,fsd=fsd_c,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=16,skew=1
fwd=fixed_a_1_bg,fsd=fsd_bg,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=16,skew=13

fwd=fixed_a_2_a,fsd=fsd_a,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=16,skew=85
fwd=fixed_a_2_b,fsd=fsd_b,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=16,skew=1
fwd=fixed_a_2_c,fsd=fsd_c,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=16,skew=1
fwd=fixed_a_2_bg,fsd=fsd_bg,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=16,skew=13

fwd=fixed_a_3_a,fsd=fsd_a,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=16,skew=85
fwd=fixed_a_3_b,fsd=fsd_b,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=16,skew=1
fwd=fixed_a_3_c,fsd=fsd_c,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=16,skew=1
fwd=fixed_a_3_bg,fsd=fsd_bg,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=16,skew=13

fwd=fixed_a_4_a,fsd=fsd_a,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=16,skew=85
fwd=fixed_a_4_b,fsd=fsd_b,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=16,skew=1
fwd=fixed_a_4_c,fsd=fsd_c,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=16,skew=1
fwd=fixed_a_4_bg,fsd=fsd_bg,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=16,skew=13

rd=fixed_a_1,fwd=(fixed_a_1_a,fixed_a_1_b,fixed_a_1_c,fixed_a_1_bg),fwdrate=1000,elapsed=150,interval=1
rd=fixed_a_2,fwd=(fixed_a_2_a,fixed_a_2_b,fixed_a_2_c,fixed_a_2_bg),fwdrate=1000,elapsed=150,interval=1
rd=fixed_a_3,fwd=(fixed_a_3_a,fixed_a_3_b,fixed_a_3_c,fixed_a_3_bg),fwdrate=1000,elapsed=150,interval=1
rd=fixed_a_4,fwd=(fixed_a_4_a,fixed_a_4_b,fixed_a_4_c,fixed_a_4_bg),fwdrate=1000,elapsed=150,interval=1
