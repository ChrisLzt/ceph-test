* MapReduce fixed-hot vdbench v1 - run only
* Reuses the existing bigdata_mapreduce_vdbench_v1 dataset.
* Purpose: isolate fixed-hot behavior from hotspot migration behavior.

data_errors=1
create_anchors=yes
messagescan=no
abort_failed_skew=2

hd=default,vdbench=@VDBENCH_HOME@,user=@REMOTE_USER@,shell=ssh
hd=hd1,system=@HOST1@

fsd=default,depth=1,width=1,shared=yes,openflags=o_direct
fsd=fsd_a,anchor=@ANCHOR@/pool_01,files=400,size=12m
fsd=fsd_b,anchor=@ANCHOR@/pool_02,files=400,size=12m
fsd=fsd_c,anchor=@ANCHOR@/pool_03,files=400,size=12m
fsd=fsd_bg,anchor=@ANCHOR@/pool_04,files=8800,size=12m

fwd=fixed_a_1_a,fsd=fsd_a,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=@THREADS@,skew=85
fwd=fixed_a_1_b,fsd=fsd_b,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=@THREADS@,skew=1
fwd=fixed_a_1_c,fsd=fsd_c,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=@THREADS@,skew=1
fwd=fixed_a_1_bg,fsd=fsd_bg,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=@THREADS@,skew=13

fwd=fixed_a_2_a,fsd=fsd_a,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=@THREADS@,skew=85
fwd=fixed_a_2_b,fsd=fsd_b,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=@THREADS@,skew=1
fwd=fixed_a_2_c,fsd=fsd_c,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=@THREADS@,skew=1
fwd=fixed_a_2_bg,fsd=fsd_bg,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=@THREADS@,skew=13

fwd=fixed_a_3_a,fsd=fsd_a,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=@THREADS@,skew=85
fwd=fixed_a_3_b,fsd=fsd_b,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=@THREADS@,skew=1
fwd=fixed_a_3_c,fsd=fsd_c,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=@THREADS@,skew=1
fwd=fixed_a_3_bg,fsd=fsd_bg,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=@THREADS@,skew=13

fwd=fixed_a_4_a,fsd=fsd_a,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=@THREADS@,skew=85
fwd=fixed_a_4_b,fsd=fsd_b,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=@THREADS@,skew=1
fwd=fixed_a_4_c,fsd=fsd_c,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=@THREADS@,skew=1
fwd=fixed_a_4_bg,fsd=fsd_bg,operation=read,fileio=sequential,fileselect=random,xfersize=1m,threads=@THREADS@,skew=13

rd=fixed_a_1,fwd=(fixed_a_1_a,fixed_a_1_b,fixed_a_1_c,fixed_a_1_bg),fwdrate=@FWD_RATE@,elapsed=@PHASE_SECONDS@,interval=1
rd=fixed_a_2,fwd=(fixed_a_2_a,fixed_a_2_b,fixed_a_2_c,fixed_a_2_bg),fwdrate=@FWD_RATE@,elapsed=@PHASE_SECONDS@,interval=1
rd=fixed_a_3,fwd=(fixed_a_3_a,fixed_a_3_b,fixed_a_3_c,fixed_a_3_bg),fwdrate=@FWD_RATE@,elapsed=@PHASE_SECONDS@,interval=1
rd=fixed_a_4,fwd=(fixed_a_4_a,fixed_a_4_b,fixed_a_4_c,fixed_a_4_bg),fwdrate=@FWD_RATE@,elapsed=@PHASE_SECONDS@,interval=1
