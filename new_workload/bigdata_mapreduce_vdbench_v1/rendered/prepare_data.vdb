* MapReduce vdbench v1 - prepare only
* Creates the CephFS dataset. Do not use for repeated measurement runs.
* Source: Abad et al., IEEE IISWC 2012 temporal-locality and inactive-storage observations.
* See README.md and SOURCES.md before use.

data_errors=1
create_anchors=yes
messagescan=no

hd=default,vdbench=/home/chris/PDSL/vdbench,user=chris,shell=ssh
hd=hd1,system=s52.servers.hustpdsl.cn

fsd=default,depth=1,width=1,shared=yes,openflags=o_direct
fsd=fsd_a,anchor=/mnt/cephfs/bigdata_mapreduce_vdbench_v1/pool_01,files=200,size=12m
fsd=fsd_b,anchor=/mnt/cephfs/bigdata_mapreduce_vdbench_v1/pool_02,files=200,size=12m
fsd=fsd_c,anchor=/mnt/cephfs/bigdata_mapreduce_vdbench_v1/pool_03,files=200,size=12m
fsd=fsd_bg,anchor=/mnt/cephfs/bigdata_mapreduce_vdbench_v1/pool_04,files=5000,size=12m
fsd=fsd_inactive,anchor=/mnt/cephfs/bigdata_mapreduce_vdbench_v1/pool_05,files=4400,size=12m

fwd=prep_a,fsd=fsd_a,operation=read,threads=4
fwd=prep_b,fsd=fsd_b,operation=read,threads=4
fwd=prep_c,fsd=fsd_c,operation=read,threads=4
fwd=prep_bg,fsd=fsd_bg,operation=read,threads=4
fwd=prep_inactive,fsd=fsd_inactive,operation=read,threads=4

rd=prepare_clean,fwd=(prep_a,prep_b,prep_c,prep_bg,prep_inactive),format=(clean,only),fwdrate=max
rd=prepare_create,fwd=(prep_a,prep_b,prep_c,prep_bg,prep_inactive),format=(restart,only),fwdrate=max
