* AI training checkpoint vdbench v1 - prepare only
* Source model:
* - Meta DSI / ISCA 2022: large-scale training repeatedly reads and filters stored datasets.
* - MLPerf Storage checkpointing / DLIO: checkpoint write, read, and recovery semantics.
* This file only creates the CephFS dataset. Do not use for repeated measurement runs.
* Dataset ranks are equal-capacity shards used by the run profile to express Zipfian access skew.

data_errors=1
create_anchors=yes
messagescan=no

hd=default,vdbench=/home/chris/PDSL/vdbench,user=chris,shell=ssh
hd=hd1,system=s52.servers.hustpdsl.cn

fsd=default,depth=1,width=1,shared=yes,openflags=o_direct
fsd=fsd_dataset_rank_01,anchor=/mnt/cephfs/ai_training_checkpoint_vdbench_v1/dataset_rank_01,files=12,size=1g
fsd=fsd_dataset_rank_02,anchor=/mnt/cephfs/ai_training_checkpoint_vdbench_v1/dataset_rank_02,files=12,size=1g
fsd=fsd_dataset_rank_03,anchor=/mnt/cephfs/ai_training_checkpoint_vdbench_v1/dataset_rank_03,files=12,size=1g
fsd=fsd_dataset_rank_04,anchor=/mnt/cephfs/ai_training_checkpoint_vdbench_v1/dataset_rank_04,files=12,size=1g
fsd=fsd_dataset_rank_05,anchor=/mnt/cephfs/ai_training_checkpoint_vdbench_v1/dataset_rank_05,files=12,size=1g
fsd=fsd_dataset_rank_06,anchor=/mnt/cephfs/ai_training_checkpoint_vdbench_v1/dataset_rank_06,files=12,size=1g
fsd=fsd_dataset_rank_07,anchor=/mnt/cephfs/ai_training_checkpoint_vdbench_v1/dataset_rank_07,files=12,size=1g
fsd=fsd_dataset_rank_08,anchor=/mnt/cephfs/ai_training_checkpoint_vdbench_v1/dataset_rank_08,files=12,size=1g
fsd=fsd_checkpoint_current,anchor=/mnt/cephfs/ai_training_checkpoint_vdbench_v1/checkpoint_current,files=8,size=1g
fsd=fsd_checkpoint_old,anchor=/mnt/cephfs/ai_training_checkpoint_vdbench_v1/checkpoint_old,files=8,size=1g

fwd=prep_dataset_rank_01,fsd=fsd_dataset_rank_01,operation=read,threads=4
fwd=prep_dataset_rank_02,fsd=fsd_dataset_rank_02,operation=read,threads=4
fwd=prep_dataset_rank_03,fsd=fsd_dataset_rank_03,operation=read,threads=4
fwd=prep_dataset_rank_04,fsd=fsd_dataset_rank_04,operation=read,threads=4
fwd=prep_dataset_rank_05,fsd=fsd_dataset_rank_05,operation=read,threads=4
fwd=prep_dataset_rank_06,fsd=fsd_dataset_rank_06,operation=read,threads=4
fwd=prep_dataset_rank_07,fsd=fsd_dataset_rank_07,operation=read,threads=4
fwd=prep_dataset_rank_08,fsd=fsd_dataset_rank_08,operation=read,threads=4
fwd=prep_checkpoint_current,fsd=fsd_checkpoint_current,operation=read,threads=4
fwd=prep_checkpoint_old,fsd=fsd_checkpoint_old,operation=read,threads=4

rd=prepare_clean,fwd=(prep_dataset_rank_01,prep_dataset_rank_02,prep_dataset_rank_03,prep_dataset_rank_04,prep_dataset_rank_05,prep_dataset_rank_06,prep_dataset_rank_07,prep_dataset_rank_08,prep_checkpoint_current,prep_checkpoint_old),format=(clean,only),fwdrate=max
rd=prepare_create,fwd=(prep_dataset_rank_01,prep_dataset_rank_02,prep_dataset_rank_03,prep_dataset_rank_04,prep_dataset_rank_05,prep_dataset_rank_06,prep_dataset_rank_07,prep_dataset_rank_08,prep_checkpoint_current,prep_checkpoint_old),format=(restart,only),fwdrate=max
