* AI training checkpoint vdbench v1 - prepare only
* Source model:
* - Meta DSI / ISCA 2022: large-scale training repeatedly reads and filters stored datasets.
* - MLPerf Storage checkpointing / DLIO: checkpoint write, read, and recovery semantics.
* This file only creates the CephFS dataset. Do not use for repeated measurement runs.

data_errors=1
create_anchors=yes
messagescan=no

hd=default,vdbench=@VDBENCH_HOME@,user=@REMOTE_USER@,shell=ssh
hd=hd1,system=@HOST1@

fsd=default,depth=1,width=1,shared=yes,openflags=o_direct
fsd=fsd_dataset_hot,anchor=@ANCHOR@/dataset_hot,files=32,size=1g
fsd=fsd_dataset_warm,anchor=@ANCHOR@/dataset_warm,files=24,size=1g
fsd=fsd_dataset_cold,anchor=@ANCHOR@/dataset_cold,files=32,size=1g
fsd=fsd_checkpoint_current,anchor=@ANCHOR@/checkpoint_current,files=12,size=1g
fsd=fsd_checkpoint_old,anchor=@ANCHOR@/checkpoint_old,files=12,size=1g

fwd=prep_dataset_hot,fsd=fsd_dataset_hot,operation=read,threads=@FORMAT_THREADS@
fwd=prep_dataset_warm,fsd=fsd_dataset_warm,operation=read,threads=@FORMAT_THREADS@
fwd=prep_dataset_cold,fsd=fsd_dataset_cold,operation=read,threads=@FORMAT_THREADS@
fwd=prep_checkpoint_current,fsd=fsd_checkpoint_current,operation=read,threads=@FORMAT_THREADS@
fwd=prep_checkpoint_old,fsd=fsd_checkpoint_old,operation=read,threads=@FORMAT_THREADS@

rd=prepare_clean,fwd=(prep_dataset_hot,prep_dataset_warm,prep_dataset_cold,prep_checkpoint_current,prep_checkpoint_old),format=(clean,only),fwdrate=max
rd=prepare_create,fwd=(prep_dataset_hot,prep_dataset_warm,prep_dataset_cold,prep_checkpoint_current,prep_checkpoint_old),format=(restart,only),fwdrate=max
