fsd=fsd_checkpoint_current,anchor=@ANCHOR@/checkpoint_current,files=400,size=20m
fsd=fsd_checkpoint_old,anchor=@ANCHOR@/checkpoint_old,files=400,size=20m

fwd=prep_dataset_rank_01,fsd=fsd_dataset_rank_01,operation=read,threads=@FORMAT_THREADS@
fwd=prep_dataset_rank_02,fsd=fsd_dataset_rank_02,operation=read,threads=@FORMAT_THREADS@
