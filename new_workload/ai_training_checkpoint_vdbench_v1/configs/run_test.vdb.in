* AI training checkpoint vdbench v1 - run only
* Runs hot/cold identification phases against an existing dataset.
* This file intentionally contains no Vdbench formatting RD.
* Transfer sizes and thread counts are execution parameters, not claimed as paper constants.

data_errors=1
create_anchors=yes
messagescan=no

hd=default,vdbench=@VDBENCH_HOME@,user=@REMOTE_USER@,shell=ssh
hd=hd1,system=@HOST1@

fsd=default,depth=1,width=1,shared=yes,openflags=o_direct
fsd=fsd_dataset_hot,anchor=@ANCHOR@/dataset_hot,files=32,size=1g
fsd=fsd_dataset_warm,anchor=@ANCHOR@/dataset_warm,files=24,size=1g
fsd=fsd_dataset_cold,anchor=@ANCHOR@/dataset_cold,files=32,size=1g
fsd=fsd_checkpoint_current,anchor=@ANCHOR@/checkpoint_current,files=12,size=1g
fsd=fsd_checkpoint_old,anchor=@ANCHOR@/checkpoint_old,files=12,size=1g

fwd=epoch_hot_dataset,fsd=fsd_dataset_hot,operation=read,fileio=random,fileselect=random,xfersize=@READ_XFER_SIZE@,threads=@THREADS@
fwd=epoch_warm_dataset,fsd=fsd_dataset_warm,operation=read,fileio=random,fileselect=random,xfersize=@READ_XFER_SIZE@,threads=@THREADS@
fwd=checkpoint_write_current,fsd=fsd_checkpoint_current,operation=write,fileio=sequential,fileselect=random,xfersize=@CHECKPOINT_XFER_SIZE@,threads=@THREADS@
fwd=checkpoint_read_current,fsd=fsd_checkpoint_current,operation=read,fileio=sequential,fileselect=random,xfersize=@CHECKPOINT_XFER_SIZE@,threads=@THREADS@
fwd=recovery_read_old_checkpoint,fsd=fsd_checkpoint_old,operation=read,fileio=sequential,fileselect=random,xfersize=@CHECKPOINT_XFER_SIZE@,threads=@THREADS@

rd=epoch_read_hot_dataset,fwd=epoch_hot_dataset,fwdrate=@FWD_RATE@,elapsed=@PHASE_SECONDS@,interval=1
rd=epoch_read_warm_dataset,fwd=epoch_warm_dataset,fwdrate=@FWD_RATE@,elapsed=@PHASE_SECONDS@,interval=1
rd=checkpoint_write_current,fwd=checkpoint_write_current,fwdrate=@FWD_RATE@,elapsed=@PHASE_SECONDS@,interval=1
rd=checkpoint_read_current,fwd=checkpoint_read_current,fwdrate=@FWD_RATE@,elapsed=@PHASE_SECONDS@,interval=1
rd=recovery_read_old_checkpoint,fwd=recovery_read_old_checkpoint,fwdrate=@FWD_RATE@,elapsed=@PHASE_SECONDS@,interval=1
