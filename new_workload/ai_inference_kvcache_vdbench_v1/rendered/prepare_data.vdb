* AI inference KV-cache vdbench v1 - prepare only
* Source model:
* - vLLM/PagedAttention, SOSP 2023: prefill writes/generates KV cache; decode repeatedly consumes KV cache; KV blocks can be reused across related requests.
* - MLPerf Storage KV Cache: storage benchmark category for KV-cache I/O behavior.
* This file only creates the CephFS dataset. Do not use for repeated measurement runs.

data_errors=1
create_anchors=yes
messagescan=no

hd=default,vdbench=/home/chris/PDSL/vdbench,user=chris,shell=ssh
hd=hd1,system=s52.servers.hustpdsl.cn

fsd=default,depth=1,width=1,shared=yes,openflags=o_direct
fsd=fsd_kv_active,anchor=/mnt/cephfs/ai_inference_kvcache_vdbench_v1/kv_active,files=32,size=1g
fsd=fsd_kv_prefix_reuse,anchor=/mnt/cephfs/ai_inference_kvcache_vdbench_v1/kv_prefix_reuse,files=32,size=1g
fsd=fsd_kv_next,anchor=/mnt/cephfs/ai_inference_kvcache_vdbench_v1/kv_next,files=32,size=1g
fsd=fsd_kv_cold,anchor=/mnt/cephfs/ai_inference_kvcache_vdbench_v1/kv_cold,files=16,size=1g

fwd=prep_kv_active,fsd=fsd_kv_active,operation=read,threads=4
fwd=prep_kv_prefix_reuse,fsd=fsd_kv_prefix_reuse,operation=read,threads=4
fwd=prep_kv_next,fsd=fsd_kv_next,operation=read,threads=4
fwd=prep_kv_cold,fsd=fsd_kv_cold,operation=read,threads=4

rd=prepare_clean,fwd=(prep_kv_active,prep_kv_prefix_reuse,prep_kv_next,prep_kv_cold),format=(clean,only),fwdrate=max
rd=prepare_create,fwd=(prep_kv_active,prep_kv_prefix_reuse,prep_kv_next,prep_kv_cold),format=(restart,only),fwdrate=max
